# Salin menjadi .env lalu sesuaikan. Jangan commit berkas .env.

# ---------- Umum ----------
APP_ENV=development                 # development | production
APP_BASE_URL=http://localhost:8088  # alamat publik (dipakai untuk tautan surel & URL unggah MinIO)
HTTP_PORT=8088
# Sub-path publik bila aplikasi dipasang di balik proxy lain, mis. BASE_PATH=/simak untuk https://kampus.ac.id/simak/.
# Kosong = dilayani dari akar. Berubah → `docker compose up -d --build` (frontend perlu build ulang). Lihat README "Dipasang di sub-path".
BASE_PATH=

# ---------- PostgreSQL ----------
POSTGRES_DB=simak
POSTGRES_USER=simak
POSTGRES_PASSWORD=ganti-sandi-db
DATABASE_URL=postgresql+asyncpg://simak:ganti-sandi-db@postgres:5432/simak

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0

# ---------- Keamanan ----------
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
# Buat dengan: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=
COOKIE_SECURE=false                 # true bila disajikan lewat HTTPS

# ---------- MinIO (penyimpanan bukti & hasil ekspor) ----------
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:8088   # host yang dilihat peramban (lewat Nginx)
MINIO_ROOT_USER=simak-minio
MINIO_ROOT_PASSWORD=ganti-sandi-minio
MINIO_BUCKET=simak-bukti
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false

# ---------- Surel (opsional; kosongkan SMTP_HOST untuk hanya mencatat ke log) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=simak@kampus.ac.id

# ---------- Data awal (hanya untuk pengembangan) ----------
# Bila kosong, `make seed-demo` membuat sandi acak dan menampilkannya sekali di terminal (tidak ditulis di README).
# Jangan commit nilai di sini; .env sudah masuk .gitignore.
DEMO_PASSWORD=
FAKULTAS_NAMA=Fakultas Sains dan Ilmu Komputer
