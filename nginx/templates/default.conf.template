# Reverse proxy tunggal SIMAK.
#   /api/...        -> FastAPI
#   /<bucket>/...   -> MinIO (URL unggah/unduh bertanda tangan; Host harus utuh agar tanda tangan sah)
#   selain itu      -> berkas statis frontend (SPA)
# Berkas ini adalah templat: ${BASE_PATH} diisi dari .env oleh entrypoint Nginx (envsubst); variabel Nginx ($host, dst.) tidak tersentuh.

upstream simak_api      { server api:8000; }
upstream simak_frontend { server frontend:80; }
upstream simak_minio    { server minio:9000; }

server {
    listen 80;
    server_name _;

    # Batas ukuran unggahan lewat API (berkas bukti diunggah langsung ke MinIO).
    client_max_body_size 30m;

    # Sub-path publik (BASE_PATH, mis. /simak). Proxy di depan boleh melepas prefiks atau meneruskannya; keduanya diterima,
    # dan setelah baris ini seluruh aturan di bawah memakai jalur tanpa prefiks. Bila BASE_PATH kosong, baris ini tidak berefek.
    absolute_redirect off;  # Location relatif: aman di balik proxy (port/host internal tidak bocor)
    rewrite ^${BASE_PATH}$ ${BASE_PATH}/ redirect;
    rewrite ^${BASE_PATH}/(.*)$ /$1 break;

    # Header keamanan dasar.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location /api/ {
        proxy_pass http://simak_api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # Objek MinIO. Nama bucket = MINIO_BUCKET (bawaan: simak-bukti).
    location /simak-bukti/ {
        proxy_pass http://simak_minio;
        proxy_set_header Host $http_host;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 30m;
    }

    location / {
        proxy_pass http://simak_frontend;
        proxy_set_header Host $host;
    }
}
